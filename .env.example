# Public client configuration
VITE_APP_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values: never expose these with VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (cuenta tapmkt, MODO PRUEBA). Sin estas dos claves, los endpoints de
# cobro responden 503 "Stripe no configurado" y la app sigue funcionando normal.
# Nunca escribas claves reales en este archivo: van en variables de entorno del
# servidor (Render) o en un .env local fuera del repo.
# STRIPE_SECRET_KEY: clave secreta de prueba, empieza con sk_test_...
# STRIPE_WEBHOOK_SECRET: secreto de firma del endpoint /api/stripe/webhook,
# empieza con whsec_... (se obtiene al registrar el webhook en el Dashboard).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
OPS_WEBHOOK_URL=

# CI / operations (GitHub Actions secrets, not committed values)
NETLIFY_AUTH_TOKEN=
SUPABASE_DB_URL=
